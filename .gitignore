# Engine libraries that editor copies to project root, plugin links libraries from EngineLibs/ instead.
/FocalEngine.lib
/FEBasicApplication.lib

# Prebuilt third party DLLs are needed to run plugin from fresh clone.
!ThirdParty/**/*.dll

#Folders
# Build folders are anchored to root, otherwise ThirdParty/*/Debug/ and ThirdParty/*/Release/ would be ignored too.
/Debug/
/Release/
/x64/
*.dir/
.vs/
CMakeFiles/
Build/
EngineBuild/
EngineLibs/